# ============================================================
# Urban Fleet Intelligence Copilot — Backend environment
# Copy to .env and fill in your values.  Never commit .env.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=4000

# ── MySQL database ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=fleet_db
DB_POOL_MAX=10

# ── CORS — comma-separated allowed origins ───────────────────
FRONTEND_URL=http://localhost:5173

# ── ML service ───────────────────────────────────────────────
ML_URL=http://localhost:5000
ML_TIMEOUT_MS=4000
